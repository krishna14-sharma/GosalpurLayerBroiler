<?xml version="1.0"?>
<!--
  Phoenix Layer Poultry ERP - ASP.NET Web Forms 4.8 (Web Site project)
  1. Change the connection string below to point to your SQL Server.
  2. In IIS create an application on this folder using an Integrated-pipeline
     .NET CLR v4.0 application pool.
-->
<configuration>
  <connectionStrings>
    <add name="PoultryERP" connectionString="Data Source=192.168.0.150;Initial Catalog=PoultryERP;User Id=sa;Password=Ph@hoenix#g;MultipleActiveResultSets=False" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <appSettings>
    <add key="AppName" value="Phoenix Poultry ERP"/>
    <!-- failed logins before an account is locked for 15 minutes -->
    <add key="MaxFailedLogins" value="5"/>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None"/>
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8">
      <assemblies>
        <add assembly="System.IO.Compression, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"/>
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.8" maxRequestLength="10240" enableVersionHeader="false" requestValidationMode="4.5"/>
    <globalization culture="en-IN" uiCulture="en-IN" requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8"/>
    <authentication mode="Forms">
      <forms name=".PHXERP" loginUrl="~/Login.aspx" defaultUrl="~/Default.aspx" timeout="480" slidingExpiration="true" requireSSL="false" protection="All" cookieless="UseCookies"/>
    </authentication>
    <authorization>
      <deny users="?"/>
    </authorization>
    <sessionState mode="InProc" timeout="480" cookieless="UseCookies"/>
    <httpCookies httpOnlyCookies="true" requireSSL="false" sameSite="Lax"/>
    <pages theme="" validateRequest="true" enableEventValidation="true" viewStateEncryptionMode="Auto" controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID" maintainScrollPositionOnPostBack="false">
      <namespaces>
        <add namespace="System.Data"/>
        <add namespace="PoultryERP"/>
      </namespaces>
    </pages>
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx" redirectMode="ResponseRewrite"/>
  </system.web>
  <!-- public resources -->
  <location path="Login.aspx">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="Error.aspx">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="Content">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="Scripts">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="lib">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="false"/>
    <defaultDocument>
      <files>
        <clear/>
        <add value="Default.aspx"/>
      </files>
    </defaultDocument>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By"/>
        <add name="X-Content-Type-Options" value="nosniff"/>
        <add name="X-Frame-Options" value="SAMEORIGIN"/>
        <add name="Referrer-Policy" value="same-origin"/>
      </customHeaders>
    </httpProtocol>
    <staticContent>
      <remove fileExtension=".woff2"/>
      <mimeMap fileExtension=".woff2" mimeType="font/woff2"/>
    </staticContent>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="Database"/>
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>