<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.master.cs" Inherits="PoultryERP.SiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#123829" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/lib/bootstrap/css/bootstrap.min.css") %>" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/lib/bootstrap-icons/bootstrap-icons.min.css") %>" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/Content/site.css") %>?v=1" />
    <script src="<%= ResolveUrl("~/lib/jquery/jquery.min.js") %>"></script>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <div id="busyBar"></div>
    <form id="form1" runat="server" autocomplete="off">
        <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePageMethods="true" EnablePartialRendering="true" AsyncPostBackTimeout="300" />

        <aside class="app-sidebar" aria-label="Main navigation">
            <a class="app-brand" href="<%= ResolveUrl("~/Default.aspx") %>">
                <span class="brand-mark">P</span>
                <span class="brand-text"><b>Phoenix Poultry</b><small>Layer Farm ERP</small></span>
            </a>
            <nav class="app-nav"><asp:Literal ID="litNav" runat="server" Mode="PassThrough" /></nav>
        </aside>
        <div class="sidebar-backdrop"></div>

        <div class="app-main">
            <header class="app-topbar">
                <button type="button" class="btn btn-light btn-sm sidebar-toggle" aria-label="Open menu"><i class="bi bi-list fs-5"></i></button>
                <h1 class="page-title flex-grow-1"><%: PageHeading %></h1>

                <asp:PlaceHolder ID="phCompany" runat="server" Visible="false">
                    <asp:DropDownList ID="ddlCompany" runat="server" CssClass="form-select form-select-sm company-switch"
                        AutoPostBack="true" OnSelectedIndexChanged="ddlCompany_SelectedIndexChanged" ToolTip="Active company" />
                </asp:PlaceHolder>
                <asp:Literal ID="litCompanyName" runat="server" />

                <div class="dropdown">
                    <a href="#" class="user-chip dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="avatar"><asp:Literal ID="litInitials" runat="server" /></span>
                        <span class="meta"><b class="d-block small"><asp:Literal ID="litUser" runat="server" /></b><small><asp:Literal ID="litRole" runat="server" /></small></span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li><a class="dropdown-item" href="<%= ResolveUrl("~/ChangePassword.aspx") %>"><i class="bi bi-key me-2"></i>Change password</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item text-danger" href="<%= ResolveUrl("~/Logout.aspx") %>"><i class="bi bi-box-arrow-right me-2"></i>Sign out</a></li>
                    </ul>
                </div>
            </header>

            <main class="app-content">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </main>
            <footer class="app-footer no-print">&copy; <%= DateTime.Today.Year %> Phoenix Poultry ERP &middot; <%: Ctx.Company.Name %></footer>
        </div>
    </form>
    <script src="<%= ResolveUrl("~/lib/bootstrap/js/bootstrap.bundle.min.js") %>"></script>
    <script src="<%= ResolveUrl("~/Scripts/app.js") %>?v=1"></script>
    <asp:ContentPlaceHolder ID="ScriptContent" runat="server" />
</body>
</html>
